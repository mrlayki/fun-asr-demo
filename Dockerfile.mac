# Mac / 无 NVIDIA：默认 ubuntu:22.04（官方镜像压缩约 70–80MB，远小于 torch+funasr 运行时）。
# 复用本机已有镜像（不再拉 ubuntu 层），例如你机器上的 asr_asr-service:latest：
#   docker compose -f docker-compose.mac.yml build --build-arg BASE_IMAGE=asr_asr-service:latest
# 或在 docker-compose.mac.yml 的 build.args 里写 BASE_IMAGE。

ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 若 BASE_IMAGE 里已有 uv + python3（例如你之前构建过的 asr 服务镜像），则跳过 apt/curl，只叠业务文件。
RUN set -eux; \
    if command -v uv >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then \
      echo "BASE_IMAGE 已含 uv 与 python3，跳过系统包安装"; \
    else \
      apt-get update && apt-get install -y \
        python3.10 python3-pip python3.10-venv \
        ffmpeg curl ca-certificates \
        && rm -rf /var/lib/apt/lists/* \
        && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
        && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh; \
    fi

WORKDIR /app

COPY asr_manager.py .
COPY funasr_wss_server.py .
# Fun-ASR-Nano 离线模型依赖仓库内 model.py（及 ctc、tools），供 remote_code 加载
COPY model.py ctc.py ./
COPY tools/ ./tools/

ENV ASR_AUTO_START=true

EXPOSE 10095

CMD ["python3", "asr_manager.py"]
